# =====================================================================
# Environment Variables Required for Vercel Deployment
# =====================================================================
# Copy this file to .env locally and fill in the values.
# On Vercel: add these in Project → Settings → Environment Variables.
# NEVER commit your real .env file to git.
# =====================================================================

# ------------------------------------------------------------------
# MongoDB Atlas (REQUIRED)
# Get from: https://cloud.mongodb.com → Connect → Drivers
# Format:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# ------------------------------------------------------------------
MONGODB_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME="enterprise_workforce_db"

# ------------------------------------------------------------------
# JWT Authentication (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------
JWT_SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET"

# ------------------------------------------------------------------
# Bootstrap Admin Account (REQUIRED on first deploy)
# Password used to seed the initial HR Admin account in MongoDB.
# Can be changed after first login.
# ------------------------------------------------------------------
AUTH_BOOTSTRAP_PASSWORD="REPLACE_WITH_INITIAL_ADMIN_PASSWORD"

# ------------------------------------------------------------------
# Google Gemini AI (OPTIONAL — enables AI chat & insights)
# Get from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------
GEMINI_API_KEY=""

# ------------------------------------------------------------------
# CORS origins (OPTIONAL — Vercel preview URLs are auto-allowed)
# Add your custom domain here if using one.
# ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=""

# ------------------------------------------------------------------
# App metadata (OPTIONAL — has defaults)
# ------------------------------------------------------------------
PROJECT_NAME="Enterprise AI Workforce Management System API"
VERSION="1.0.0"
API_V1_STR="/api"

# ------------------------------------------------------------------
# Automation Scheduler
# Set to True to enable APScheduler jobs (development only)
# ------------------------------------------------------------------
AUTOMATION_ENABLED=False
ATTENDANCE_RECONCILIATION_INTERVAL_MINUTES=15

# ------------------------------------------------------------------
# Office Geofence (optional; used by GPS attendance checks)
# ------------------------------------------------------------------
OFFICE_LATITUDE=0.0
OFFICE_LONGITUDE=0.0
OFFICE_GEOFENCE_RADIUS_METERS=200.0

# ------------------------------------------------------------------
# Application timezone (used by scheduler and time comparisons)
# ------------------------------------------------------------------
APP_TIMEZONE="UTC"